{
  "name": "@jybk/pptb-dataverse-m-builder",
  "version": "1.3.0",
  "displayName": "Dataverse M Builder",
  "description": "Generate Power Query (M) scripts for Power BI, Excel and dataflows from Dataverse tables, views or FetchXML, with full paging, readable labels and choice tables.",
  "main": "index.html",
  "icon": "icons/dataverse-m-builder.svg",
  "author": "Jay",
  "contributors": [
    {
      "name": "Jay"
    }
  ],
  "license": "MIT",
  "keywords": [
    "powerplatform",
    "dataverse",
    "toolbox",
    "power-bi",
    "power-query",
    "fetchxml",
    "m"
  ],
  "homepage": "https://github.com/jybk/pptb-dataverse-m-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jybk/pptb-dataverse-m-builder.git"
  },
  "bugs": {
    "url": "https://github.com/jybk/pptb-dataverse-m-builder/issues"
  },
  "configurations": {
    "repository": "https://github.com/jybk/pptb-dataverse-m-builder",
    "website": "https://github.com/jybk/pptb-dataverse-m-builder#readme",
    "readmeUrl": "https://raw.githubusercontent.com/jybk/pptb-dataverse-m-builder/main/README.md"
  },
  "features": {
    "connections": 1,
    "minAPI": "1.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "pack:marketplace": "npm run build && node scripts/pack-marketplace.mjs",
    "dev": "vite",
    "watch": "vite build --watch",
    "dev-watch": "vite build --mode development --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate",
    "prepublishOnly": "npm run build && npm test",
    "version-stable": "npm version patch --no-git-tag-version",
    "publish-package": "npm run build && npm run version-stable && npm publish --access public"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@microsoft/powerquery-parser": "^5.0.0",
    "@pptb/types": "^1.2.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "pptb.config.json",
    "npm-shrinkwrap.json"
  ]
}
